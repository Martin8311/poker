# Copy this file to .env before running docker compose.

# MySQL root password used by the mysql container and Spring Boot datasource.
MYSQL_ROOT_PASSWORD=poker_root_pwd

# Redis password used by Redis, Spring Data Redis, Spring Session and Redisson.
REDIS_PASSWORD=123456

# RabbitMQ default account and Spring WebSocket STOMP broker relay account.
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# Grafana login for http://localhost:3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Optional: comma-separated usernames promoted to ADMIN on application startup.
APP_BOOTSTRAP_ADMINS=

# Local development helper. Set false for demos/production.
PHONE_VERIFICATION_DEBUG=true
